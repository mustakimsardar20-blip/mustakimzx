<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ime"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Live status + last received value -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_key_alt"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/ime_hint_idle"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/scanPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_scan_preview"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Action row: send last / clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSendLast"
            style="@style/ImeKeyPrimary"
            android:text="@string/key_send_last" />

        <TextView
            android:id="@+id/btnToggleAutoEnter"
            style="@style/ImeKeyWide"
            android:text="@string/autoenter_on" />

        <TextView
            android:id="@+id/btnSwitchIme"
            style="@style/ImeKeyWide"
            android:text="⌨" />
    </LinearLayout>

    <!-- Row 1: 1234567890 -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal" />

    <!-- Row 2: qwertyuiop -->
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal" />

    <!-- Row 3: asdfghjkl -->
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal" />

    <!-- Row 4: shift + zxcvbnm + backspace -->
    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal" />

    <!-- Row 5: symbols / comma / space / dot / enter -->
    <LinearLayout
        android:id="@+id/row5"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal" />
</LinearLayout>
